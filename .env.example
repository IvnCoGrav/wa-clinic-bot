# Server Config
PORT=3000
HOST=0.0.0.0

# Admin API Security Token (Must be a long, secure random string - e.g. generated via: openssl rand -hex 32)
ADMIN_API_KEY="my_secure_random_admin_api_key"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wa_clinic_db?schema=public"

# WAHA (WhatsApp HTTP API Self-Hosted) Config
WAHA_BASE_URL="http://localhost:3001"             # Default code: http://localhost:3001 (WAHA container)
WAHA_API_KEY="3659a2481bce46a2801173dc5ec7d668"
WAHA_SESSION="default"
THRESHOLD_STUCK_STARTING_MINUTES=5
WAHA_MOCK=false
WAHA_WEBHOOK_SECRET=""                            # WAJIB diisi di produksi; verifikasi signature webhook POST /webhook
ENABLE_WAHA_HOLD_LABEL=true                       # Feature flag label HOLD saat human handling (default true, set false untuk menonaktifkan)

# === WhatsApp Label Lifecycle (Task 3/4/5) ===
ENABLE_LIFECYCLE_LABELS=true                      # Label 'new customer'/'pending payment'/'repeat' lifecycle

# === Legacy Per-Contact Scrape Trigger (Task 2) ===
ENABLE_LEGACY_LABEL_SCRAPE_TRIGGER=false          # Picu scrape legacy per-contact saat chat di-label 'legacy'
LEGACY_SCRAPE_DRY_RUN=false                       # true = scrape jalan tapi TIDAK addLabel 'hold'/'legacy'
LEGACY_SCRAPE_MAX_MESSAGES=200                    # Maksimal pesan yang dibaca per chat saat scrape

# === Label Reconciliation Cron (Task 7) ===
ENABLE_LABEL_RECONCILIATION_CRON=false            # Cron re-sync label WA vs status DB
LABEL_RECONCILIATION_INTERVAL_HOURS=4             # Interval cron (jam)


# Google Maps Geocoding API (Text & Reverse Geocoding)
GOOGLE_MAPS_API_KEY="AIzaSy..."

# OpenRouteService (ORS) Directions API (Distance/Routing Calculation)
ORS_BASE_URL="https://api.openrouteservice.org"
ORS_PROFILE="cycling-electric"
ORS_API_KEY="<ISI_MANUAL_DI_ENV_JANGAN_HARDCODE>"
ORS_HTTP_TIMEOUT_MS=10000

# Clinic Location Configuration (Titik awal lokasi moms & baby spa)
CLINIC_LAT=-7.34886
CLINIC_LNG=112.751677
CLINIC_NAME="Kala Moms and Baby Spa"
# Batas maksimal jangkauan home-treatment (km); cap atas fallback saat tier ongkir tidak terisi.
MAX_DELIVERY_DISTANCE_KM=30
# Faktor pembulatan jarak lurus (Haversine) ke estimasi jarak jalan saat ORS gagal.
HAVERSINE_CIRCUITY_FACTOR=1.50

# Human Handling Timeout (Jam)
HUMAN_HANDLING_TIMEOUT_HOURS=6

# State Machine / Timeout (Fase 4.3)
IDLE_TIMEOUT_MS=86400000                         # Reset percakapan jika idle lebih dari nilai ini (default 24 jam)
LOCATION_CONFIRMATION_TIMEOUT_MS=300000          # Timeout konfirmasi lokasi di state LOCATION_CONFIRMED (default 5 menit)
LOCATION_ATTEMPTS_LIMIT=3                        # Jumlah maksimal gagal deteksi kelurahan sebelum eskalasi human handling

# Abuse Detection Thresholds (Fase 4.3)
FLOOD_LIMIT=10                                   # Ambang jumlah pesan dalam window untuk deteksi flood
FLOOD_WINDOW_MS=60000                            # Sliding window deteksi flood (ms)
SPAM_DUPLICATE_LIMIT=5                           # Ambang pesan identik berurutan saat human handling

# Follow-up Worker Tuning (Fase 4.3)
FOLLOWUP_BATCH_LIMIT=20                          # Jumlah follow-up due per eksekusi worker
FOLLOWUP_THROTTLE_BASE_MS=1500                   # Base throttle antar customer (delay = base s/d base*10)
LOST_CUSTOMER_GRACE_DAYS=3                       # Grace period sebelum customer ditandai 'lost' setelah follow-up Stage 3

# Admin Dashboard Identity (env-drivable, tanpa nilai produksi di code)
# ADMIN_DOMAIN=example.com                      # Base domain; guard origin isolation aktif bila terisi
# ADMIN_EMAIL=admin@example.com                 # Email admin yang ditampilkan di response auth

# Reservation Form URL — TIDAK DIBACA oleh code (dead var, dihapus)
# RESERVATION_FORM_URL="https://klinik-treatment.com/booking"

# Redis & Queue (fallback in-memory otomatis bila Redis down)
REDIS_HOST="localhost"
REDIS_PORT=6379
QUEUE_SHARDS=1                                   # Jumlah shard queue follow-up

# Burst Coalescing — gabungkan pesan text beruntun jadi 1 balasan
# BURST_COALESCE_MS=0 (default) = nonaktif; contoh 5000 = gabung dalam window 5 detik
BURST_COALESCE_MS=0
BURST_COALESCE_MAX_MESSAGES=10                  # Batas pesan per batch (preventif)

# LLM / OpenAI Custom Endpoint Config
OPENAI_BASE_URL="https://ai.sumopod.com/v1"
OPENAI_MODEL="MiniMax-M2.7-highspeed"
OPENAI_API_KEY=""                                # API key provider OpenAI (bila AI_PROVIDER_*=OpenAI)
LLM_API_KEY="sk-znFVknm5AgYRh8G4PzH7wQ"

# AI Model Registry (per-task; default MiniMax)
AI_PROVIDER_CHAT="MiniMax"                       # Provider task CHAT_REPLY
AI_MODEL_CHAT="MiniMax-M2.7-highspeed"
AI_PROVIDER_NLU="MiniMax"                        # Provider task NLU
AI_MODEL_NLU="MiniMax-M2.7-highspeed"
AI_PROVIDER_MEDICAL="MiniMax"                    # Provider task MEDICAL_CHECK
AI_MODEL_MEDICAL="MiniMax-M2.7-highspeed"
AI_PROVIDER_HARVESTING="MiniMax"                 # Provider task HARVESTING
AI_MODEL_HARVESTING="MiniMax-M2.7-highspeed"
AI_PROVIDER_PII="MiniMax"                        # Provider task PII
AI_MODEL_PII="MiniMax-M2.7-highspeed"
AI_PROVIDER_SUMMARIZATION="MiniMax"              # Provider task SUMMARIZATION
AI_MODEL_SUMMARIZATION="MiniMax-M2.7-highspeed"
NLU_CONFIDENCE_THRESHOLD=0.60                    # Ambang confidence NLU fallback deterministik

# WhatsApp Business API (WABA) — env dibaca oleh WABA driver/webhook
WABA_APP_SECRET=""                               # App Secret Meta untuk verifikasi X-Hub-Signature-256
WABA_WEBHOOK_VERIFY_TOKEN=""                     # Verify token webhook Meta Cloud API

# Telegram Alert (opsional, fallback ke file log bila kosong)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Pricalist / Attachment
CLINIC_PRICELIST_IMAGE_URL=""                    # URL gambar pricelist treatment (opsional)

# === Live Chat Media (gambar outbound/inbound) ===
# Gambar disimpan lokal di storage/media/{outbound,inbound}/<tenantId> dan diserve
# via /media/... . Outbound publik (dibutuhkan Meta/WABA utk kirim), inbound privat
# (hanya dashboard ber-login).
PUBLIC_BASE_URL=""                               # Base URL publik bot (WAJIB utk kirim gambar via WABA)
MEDIA_RETENTION_DAYS=30                          # Fallback global retensi media (default 30 hari; per-tenant: tenants.media_retention_days)
ENABLE_MEDIA_CLEANUP_CRON=false                  # Cron hapus file media yang melebihi retensi
MEDIA_CLEANUP_INTERVAL_HOURS=24                  # Interval cron (jam)

# Wilayah layanan (Fase 5.1) — CSV nama kelurahan/kecamatan/kota yang dikenali
# classifier sebagai penanda lokasi. Kosong = daftar default historis.
# SERVICE_AREAS="rungkut,mulyosari,sidoarjo,surabaya"

# Alert webhook (opsional)
ALERT_WEBHOOK_URL=""

# AI Router Engine (LLM Intent Classifier) Config
# SUMBER KEBENARAN: kolom tenants.ai_router_enabled / ai_router_shadow_mode (default ON + shadow ON).
# Env vars di bawah HANYA fallback saat DB tidak tersedia (offline/testing) & override ops darurat.
# Toggle per tenant dari admin dashboard: Settings -> AI Router Engine.
AI_ROUTER_ENABLED=false                          # FALLBACK env saja. Default ON via DB (tenants.ai_router_enabled=true).
AI_ROUTER_SHADOW_MODE=false                      # FALLBACK env saja. Default ON via DB (aman: hanya LOG ke ai_router_evaluations).
AI_MODEL_ROUTER=""                               # Model LLM khusus router (kosong = fallback ke AI_MODEL_NLU / OPENAI_MODEL)
ESCALATE_SCHEDULE_IN_INITIAL=true                # Eskalasi pertanyaan jadwal spesifik di state INITIAL
LLM_HISTORY_LIMIT=6                              # Jumlah riwayat percakapan yang dikirim ke LLM (NLU/router/generator)

# Humanizer / Human Typing Simulation Config
HUMANIZER_ENABLED=true                           # Toggle simulasi mengetik balasan manusia
HUMANIZER_READING_BASE_MS=400                    # Waktu reaksi awal membaca (ms)
HUMANIZER_READING_MS_PER_CHAR=15                 # Waktu membaca per karakter pesan masuk (ms)
HUMANIZER_READING_DELAY_MAX_MS=2500              # Batas maksimal jeda membaca pesan masuk (ms)
HUMANIZER_TYPING_AVERAGE_WPM=48                  # Kecepatan rata-rata mengetik HP (Rata-rata manusia: 25-55 WPM, max <=55 agar tidak seperti bot)
HUMANIZER_TYPING_REACTION_MS=300                 # Waktu reaksi saat mulai mengetik (ms)
HUMANIZER_MAX_TYPING_DELAY_MS=6500               # Batas maksimal durasi indikator mengetik per bubble (ms)
HUMANIZER_JITTER_PERCENT=20                      # Persentase variasi acak/jitter (+/- %) agar delay tidak kaku
HUMANIZER_BUBBLE_SPLIT_ENABLED=true              # Toggle pemotongan teks balasan panjang menjadi multiple bubble
HUMANIZER_BUBBLE_SINGLE_THRESHOLD_CHARS=350      # Batas panjang karakter di bawahnya dikirim dalam 1 bubble tunggal
HUMANIZER_BUBBLE_MAX_COUNT=2                     # Batas maksimal jumlah bubble per respons (maks 2 bubble)
HUMANIZER_BUBBLE_MAX_CHARS=250                   # Target batas karakter per bubble sebelum di-split (~250 char per bubble)
HUMANIZER_INTER_BUBBLE_DELAY_MIN_MS=900          # Jeda minimal antar pengiriman bubble (ms)
HUMANIZER_INTER_BUBBLE_DELAY_MAX_MS=1800         # Jeda maksimal antar pengiriman bubble (ms)
HUMANIZER_HTTP_TIMEOUT_MS=10000                  # Timeout guard panggilan API ke WAHA (ms)

# Temporary Safety Net: Terminal Approval before sending messages (true/false)
TERMINAL_APPROVAL_ENABLED=false

# Google Contacts Integration (OAuth 2.0 Credentials)
# Masukkan kredensial Anda di sini untuk mengaktifkan sinkronisasi otomatis ke Google Contacts
GOOGLE_CLIENT_ID=""                              # Google OAuth Client ID
GOOGLE_CLIENT_SECRET=""                          # Google OAuth Client Secret
GOOGLE_REFRESH_TOKEN=""                          # Google OAuth Refresh Token

# Google Calendar Integration (Service Account)
# Kosong = fallback Mock mode
GOOGLE_CALENDAR_CLIENT_EMAIL=""                  # Service Account email
GOOGLE_CALENDAR_PRIVATE_KEY=""                   # Service Account private key (ganti \n menjadi newline)
GOOGLE_CALENDAR_ID=""                            # ID kalender tujuan

# Ad Click Attribution & Meta Conversions API (CAPI)
TRACKING_API_KEY=""                              # Token pengaman untuk API Tracking, wajib diisi (fail-closed)
FB_PIXEL_ID=""                                   # ID Pixel Facebook Anda
FB_CAPI_ACCESS_TOKEN=""                          # Access Token dari Meta untuk Conversions API (Server-Side Events)

# Multi Landing Page — base URL publik tempat landing page disajikan
# (dipakai untuk preview URL di admin & resolusi /api/tenant/:slug). Kosong = fallback TRACKING_API_BASE_URL.
LANDING_BASE_URL="https://landing.example.com"

# Landing page & tracking atribusi di-serve langsung oleh bot (port 3000 / domain utama).
# Nomor WA default jika parameter ?phone= tidak ada di query string.
DEFAULT_WHATSAPP_PHONE=628123456789



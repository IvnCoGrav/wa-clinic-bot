# Server Config
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=simple                              # Format log terminal: simple (ringkasan stage percakapan) | debug (termasuk micro-log teknis ms/shadow)

# Admin API Security Token (Must be a long, secure random string - e.g. generated via: openssl rand -hex 32)
ADMIN_API_KEY="my_secure_random_admin_api_key"

# Kunci Enkripsi Token Rahasia (AES-256-GCM 32-byte hex, misal: openssl rand -hex 32 / node crypto)
WABA_TOKEN_ENCRYPTION_KEY="your_waba_token_encryption_key_32_bytes_hex"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wa_clinic_db?schema=public"

# WAHA (WhatsApp HTTP API Self-Hosted) Config
WAHA_BASE_URL="http://localhost:3001"             # Default code: http://localhost:3001 (WAHA container)
WAHA_API_KEY="your_waha_api_key_secret"
WAHA_SESSION="default"
THRESHOLD_STUCK_STARTING_MINUTES=5
WAHA_MOCK=false
WAHA_RETRY_ATTEMPTS=2                        # Retry call WAHA saat error transien (timeout/koneksi), default 2
WAHA_RETRY_BACKOFF_MS=1500                   # Jeda antar percobaan retry (ms), default 1500
WAHA_MAX_CONCURRENT_CALLS=6                  # Batas call HTTP WAHA berjalan bersamaan (limiter), default 6
WAHA_WEBHOOK_SECRET=""                            # WAJIB diisi di produksi; verifikasi signature webhook POST /webhook
WAHA_WEBHOOK_URL=""                               # URL webhook yang dikirim ke WAHA saat start session (default http://app:3000/webhook)
ENABLE_WAHA_HOLD_LABEL=false                      # Feature flag label HOLD WAHA (default false untuk mencegah session logout akibat App State Protobuf issue)
ENABLE_WAHA_UNREAD=false                          # Feature flag markUnread WAHA (default false)

# === WhatsApp Label Lifecycle (Task 3/4/5) ===
ENABLE_LIFECYCLE_LABELS=false                     # Label 'new customer'/'pending payment'/'repeat' lifecycle (default false)

# === Legacy Per-Contact Scrape Trigger (Task 2) ===
ENABLE_LEGACY_LABEL_SCRAPE_TRIGGER=false          # Picu scrape legacy per-contact saat chat di-label 'legacy'
LEGACY_SCRAPE_DRY_RUN=false                       # true = scrape jalan tapi TIDAK addLabel 'hold'/'legacy'
LEGACY_SCRAPE_MAX_MESSAGES=200                    # Maksimal pesan yang dibaca per chat saat scrape

# === Label Reconciliation Cron (Task 7) ===
ENABLE_LABEL_RECONCILIATION_CRON=false            # Cron re-sync label WA vs status DB
LABEL_RECONCILIATION_INTERVAL_HOURS=4             # Interval cron (jam)


# Google Maps Geocoding API (Text & Reverse Geocoding)
# DEPRECATED: sistem beralih ke gazetteer lokal (Surabaya/Sidoarjo) + LLM fallback.
# Google Maps client sudah dihapus dari kode; variabel ini dibiarkan hanya untuk kompatibilitas.
GOOGLE_MAPS_API_KEY=""

# OpenRouteService (ORS) Directions API (Distance/Routing Calculation)
ORS_BASE_URL="https://api.heigit.org/openrouteservice"
ORS_PROFILE="driving-car"
# Fitur yang dihindari (default: tollways untuk hindari jalan tol)
ORS_AVOID_FEATURES="tollways"
ORS_API_KEY="<ISI_MANUAL_DI_ENV_JANGAN_HARDCODE>"
ORS_HTTP_TIMEOUT_MS=10000
# Preferensi rute ORS: fastest|shortest|recommended (default shortest = rute terpendek, bukan tercepat via arteri)
ORS_PREFERENCE="shortest"
# Cap jarak final = straight × ratio (default 1.60; fallback HAVERSINE_CIRCUITY_FACTOR bila kosong)
ORS_MAX_CIRCUITY_RATIO=1.60
# Faktor buffer jarak rute OpenRouteService (ORS) (default 1.10x / +10% buffer)
ORS_BUFFER_FACTOR=1.10

# Clinic Location Configuration (Titik awal lokasi moms & baby spa)
CLINIC_LAT=-7.34886
CLINIC_LNG=112.751677
CLINIC_NAME="Kala Moms and Baby Spa"
# Batas maksimal jangkauan home-treatment (km); cap atas fallback saat tier ongkir tidak terisi.
MAX_DELIVERY_DISTANCE_KM=30
# Faktor pembulatan jarak lurus (Haversine) ke estimasi jarak jalan saat ORS gagal.
HAVERSINE_CIRCUITY_FACTOR=1.60

# Human Handling Timeout (Jam)
HUMAN_HANDLING_TIMEOUT_HOURS=6

# State Machine / Timeout (Fase 4.3)
IDLE_TIMEOUT_MS=1218240000                       # Reset percakapan jika idle lebih dari nilai ini (default 14,1 hari per CG-02)
LOCATION_CONFIRMATION_TIMEOUT_MS=300000          # Timeout konfirmasi lokasi di state LOCATION_CONFIRMED (default 5 menit)
LOCATION_ATTEMPTS_LIMIT=3                        # Jumlah maksimal gagal deteksi kelurahan sebelum eskalasi human handling
MAX_INBOUND_MESSAGE_AGE_SECONDS=180              # Maksimal usia pesan masuk yang diproses bot otomatis (detik); mencegah flood pesan lama saat QR scan / reconnect (default: 180s)

# Abuse Detection Thresholds (Fase 4.3)
FLOOD_LIMIT=10                                   # Ambang jumlah pesan dalam window untuk deteksi flood
FLOOD_WINDOW_MS=60000                            # Sliding window deteksi flood (ms)
SPAM_DUPLICATE_LIMIT=5                           # Ambang pesan identik berurutan saat human handling

# Follow-up Worker Tuning (Fase 4.3)
FOLLOWUP_BATCH_LIMIT=20                          # Jumlah follow-up due per eksekusi worker
FOLLOWUP_THROTTLE_BASE_MS=1500                   # Base throttle antar customer (delay = base s/d base*10)
LOST_CUSTOMER_GRACE_DAYS=3                       # Grace period sebelum customer ditandai 'lost' setelah follow-up Stage 3

# Admin Dashboard Identity (env-drivable, tanpa nilai produksi di code)
# ADMIN_DOMAIN=example.com                      # Base domain; guard origin isolation aktif bila terisi
# ADMIN_EMAIL=admin@example.com                 # Email admin yang ditampilkan di response auth

# Reservation Form URL — TIDAK DIBACA oleh code (dead var, dihapus)
# RESERVATION_FORM_URL="https://klinik-treatment.com/booking"

# Redis & Queue (fallback in-memory otomatis bila Redis down)
REDIS_HOST="localhost"
REDIS_PORT=6379
QUEUE_SHARDS=5                                   # Jumlah shard queue (default kode 5)

# Burst Coalescing — gabungkan pesan text beruntun jadi 1 balasan (default 5000 = 5 detik)
BURST_COALESCE_MS=5000
BURST_COALESCE_MAX_MESSAGES=10                  # Batas pesan per batch (preventif)

# LLM / Provider Config (server utama SumoPod, cadangan Kenari)
ACTIVE_LLM_PROVIDER="SUMOPOD"                        # Default provider aktif: SUMOPOD atau KENARI

# Provider Kenari (https://kenari.id) — server cadangan / Tier 2
KENARI_BASE_URL="https://kenari.id/v1"
KENARI_API_KEY="kn-your-api-key-here"
KENARI_DEFAULT_MODEL="deepseek-v4-1-flash"

# Provider SumoPod (https://ai.sumopod.com) — server utama / Tier 1
SUMOPOD_BASE_URL="https://ai.sumopod.com/v1"
SUMOPOD_API_KEY="sk-your-sumopod-key-here"
SUMOPOD_DEFAULT_MODEL="glm-5.3-flash"

# OpenAI-Compatible Fallback / Generic Base URL
OPENAI_BASE_URL="https://ai.sumopod.com/v1"
OPENAI_MODEL="glm-5.3-flash"
OPENAI_API_KEY=""                                # API key provider OpenAI (bila AI_PROVIDER_*=OpenAI)
LLM_API_KEY="your_llm_api_key_here"
# Tool-Masking Direct Enforce (pre-LLM deterministic gating save_reservation).
TOOL_MASKING_ENFORCE=true                        # Default kode: true (enforce aktif; set 'false' untuk shadow/pengujian)
TOOL_MASKING_SHADOW_MODE=false                   # Default kode: false (telemetri bayangan mati saat enforce aktif)
ENABLE_SELF_LEARNING="false"                         # Matikan/aktifkan fitur passive self-learning saat CS membalas manual
LLM_TIMEOUT_CHAT_MS=120000                       # Generator/Phrasing/Intent (2 menit)
LLM_TIMEOUT_NLU_MS=120000                        # NLU classification (dipakai Call 1 routing & geocoding LLM; 2 menit)
LLM_TIMEOUT_REPORT_MS=60000                      # Daily Ops Report LLM summary (1 menit)
LLM_TIMEOUT_GLM_MS=60000                         # Gateway V3 primary+fallback tier GLM (reasoning panjang; fallback env, default 60000)

# AI Model Registry (per-task; sumber kebenaran DB tenant_ai_config, nilai di sini fallback env)
# Provider aktif default = SUMOPOD (server utama), model default = glm-5.3-flash.
AI_PROVIDER_CHAT="SumoPod"                        # Provider task CHAT_REPLY
AI_MODEL_CHAT="glm-5.3-flash"              # Primary chat (label: glm-5.3-flash (SumoPod Utama))
AI_PROVIDER_NLU="SumoPod"                         # Provider task NLU
AI_MODEL_NLU="glm-5.3-flash"               # Model NLU classification
# === Fallback LLM 3-TIER (katalog live 2026-09-21) ===
#   Tier 1 (primary)   : SumoPod        -> glm-5.3-flash
#   Tier 2 (secondary) : Kenari         -> deepseek-v4-1-flash
#   Tier 3 (last)      : DeepSeek Direct -> deepseek-chat
# AI_MODEL_FALLBACK = model Tier 3 (DeepSeek Direct last-resort). Default kode: deepseek-chat.
AI_MODEL_FALLBACK="deepseek-chat"               # Penyelamat terakhir (Tier 3 DeepSeek Direct)
# Rantai fallback DALAM provider yang sama (Tier 1 internal), dipisah koma — dicoba BERURUTAN.
# Default kode kini HANYA model primer SumoPod (tanpa chain internal). Kosongkan untuk default.
AI_MODEL_FALLBACK_CHAIN="glm-5.3-flash"    # Tier 1 internal (opsional; default hanya primer)
# Tier 2 SumoPod: dipakai otomatis bila SUMOPOD_BASE_URL + SUMOPOD_API_KEY (atau OPENAI_BASE_URL + LLM_API_KEY) terisi.
# Tier 3 DeepSeek Direct = penyelamat TERAKHIR sebelum regex/breaker (api.deepseek.com).
# LLM_FALLBACK_BASE_URL kosong / API key kosong → Tier 3 dilewati.
LLM_FALLBACK_BASE_URL="https://api.deepseek.com"  # Last-resort external official server (Tier 3)
LLM_FALLBACK_API_KEY=""                           # API key official DeepSeek (Tier 3); kosong = Tier 3 dilewati
AI_PROVIDER_MEDICAL="Alibaba"                    # Provider task MEDICAL_CHECK
AI_MODEL_MEDICAL="qwen3.7-flash-2026-07-15"
AI_PROVIDER_HARVESTING="SumoPod"                  # Provider task HARVESTING (default kode SumoPod/netra)
AI_MODEL_HARVESTING="glm-5.3-flash"        # Model HARVESTING (legacy-harvesting.service.ts)
AI_PROVIDER_PII="SumoPod"                         # Provider task PII
AI_MODEL_PII="glm-5.3-flash"
AI_PROVIDER_SUMMARIZATION="SumoPod"               # Provider task SUMMARIZATION
AI_MODEL_SUMMARIZATION="glm-5.3-flash"
# GLM thinking selalu-on: injeksi reasoning_effort otomatis di model-fallback (hanya glm via SumoPod).
# 'low' = hemat (±95% reasoning terpangkas, terukur live); 'high'/'max' untuk deep consult. Bisa di-override per-payload.
LLM_REASONING_EFFORT="low"
NLU_CONFIDENCE_THRESHOLD=0.60                    # Ambang confidence NLU fallback deterministik
# Mode eval A/B NLU (tanpa ubah config DB): set keduanya untuk window eval.
NLU_PRIMARY_MODEL=""                             # Override model primary NLU selama eval (opsional)
NLU_EVAL_RUN=""                                  # Label window (mis. 'runA-qwen'); dicatat di llm_audit_logs.eval_run

# DeepSeek harvesting (fallback saat AI_PROVIDER_HARVESTING=DeepSeek; default pakai LLM_API_KEY/OPENAI_API_KEY)
DEEPSEEK_API_KEY=""                              # API key DeepSeek harvesting
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"  # Base URL DeepSeek harvesting

# Multi-tenant (sumber kebenaran DB; DEFAULT_TENANT_ID dipakai boot & skrip)
DEFAULT_TENANT_ID="default-tenant"

# WhatsApp Business API (WABA) — env dibaca oleh WABA driver/webhook
WABA_APP_SECRET=""                               # App Secret Meta untuk verifikasi X-Hub-Signature-256
WABA_WEBHOOK_VERIFY_TOKEN=""                     # Verify token webhook Meta Cloud API
WHATSAPP_TOKEN=""                                # (legacy driver) Access token WABA
WHATSAPP_PHONE_NUMBER_ID=""                      # (legacy driver) Phone Number ID WABA

# Telegram Alert & Notification (opsional, fallback ke file log bila kosong)
# TELEGRAM_CHAT_ID dapat berupa ID Pribadi (123456789), ID Grup (-1001234567890),
# atau kombinasi Grup dan Topik/Forum (-1001234567890:42).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Pemisahan Topik/Forum Telegram per Kategori (opsional, jika menggunakan grup Forum)
TELEGRAM_TOPIC_DAILY_REPORT=""                      # Topic ID khusus Laporan Harian (misal: 42)
TELEGRAM_TOPIC_SYSTEM_ERRORS=""                     # Topic ID khusus Error Sistem & Outage (misal: 50)
TELEGRAM_TOPIC_MEDICAL_ALERTS=""                    # Topic ID khusus Eskalasi Medis Urgent ke Bidan (misal: 65)

# Laporan Operasional Harian via Telegram (Daily Ops Report)
# Laporan merangkum performa (sales, chat, atribusi iklan, kesehatan ops) HARI SEBELUMNYA.
# Sumber kebenaran per-tenant: kolom tenants.daily_report_enabled / daily_report_hour (Admin Dashboard → Settings).
# Env di bawah fallback saat tenant tidak mengatur.
ENABLE_DAILY_REPORT_CRON=false                  # Aktifkan cron laporan harian
DAILY_REPORT_HOUR=7                             # Jam pengiriman (WIB, UTC+7)
ADMIN_DASHBOARD_URL="http://localhost:3000/admin" # Link "Buka Control Panel" di footer laporan

# Pricelist / Attachment
# Fallback env untuk gambar pricelist. Prioritas utama: tenants.pricelist_image_url
# (DB, diatur dari Admin Dashboard → Settings → Gambar Pricelist WhatsApp).
CLINIC_PRICELIST_IMAGE_URL=""                    # URL gambar pricelist treatment (opsional; fallback aset assets/pricelist_spa.jpg)

# === Live Chat Media (gambar outbound/inbound) ===
# Gambar disimpan lokal di storage/media/{outbound,inbound}/<tenantId> dan diserve
# via /media/... . Outbound publik (dibutuhkan Meta/WABA utk kirim), inbound privat
# (hanya dashboard ber-login).
PUBLIC_BASE_URL=""                               # Base URL publik bot (WAJIB utk kirim gambar via WABA)
MEDIA_RETENTION_DAYS=30                          # Fallback global retensi media (default 30 hari; per-tenant: tenants.media_retention_days)
ENABLE_MEDIA_CLEANUP_CRON=false                  # Cron hapus file media yang melebihi retensi
MEDIA_CLEANUP_INTERVAL_HOURS=24                  # Interval cron (jam)
MEDIA_QUOTA_BYTES=209715200                      # Kuota media per tenant (200 MB; per-tenant: tenants.media_quota_bytes)
ENABLE_MESSAGE_RETENTION_CRON=false              # Cron hapus record chat teks yang melebihi retensi
MESSAGE_RETENTION_INTERVAL_HOURS=24              # Interval cron retensi pesan (jam)
MESSAGE_RETENTION_DAYS=120                       # Retensi pesan teks (hari; per-tenant: tenants.message_retention_days)

# === LLM-as-Judge: AI Quality Evaluation (Tahap 3.1) ===
# Evaluasi kualitas balasan bot via LLM-as-judge (skor 1-5). Hasil disimpan ke
# tabel ai_evaluations (TERPISAH dari ai_router_evaluations agar metrik router bersih).
# Butuh LLM_API_KEY (model CHAT_REPLY/MiniMax) + gated cron (default mati/fail-close).
ENABLE_AI_EVAL_CRON=false                         # Aktifkan cron evaluasi otomatis
AI_EVAL_INTERVAL_HOURS=6                          # Interval cron (jam)
AI_EVAL_SAMPLING_PERCENT=10                       # Persen sampel pesan OUTBOUND per siklus
AI_MAX_SAMPLES=50                                 # Cap maks sampel per siklus
AI_EVAL_TIMEOUT_MS=30000                          # Timeout tiap panggilan judge LLM (MiniMax bisa >8s)

# FAQ Cache (anti-LLM, jawaban deterministik) & Idle Greeting
FAQ_CACHE_TTL_SECONDS=21600                       # TTL cache jawaban FAQ per pertanyaan (default 6 jam)
IDLE_GREETING_ENABLED=true                        # Sapaan hangat saat customer kembali setelah idle (per-tenant: tenants.idle_greeting_enabled)
IDLE_GREETING_MIN_HOURS=36                        # Ambang idle minimal sebelum sapaan hangat (jam; per-tenant: tenants.idle_greeting_min_hours)

# Wilayah layanan (Fase 5.1) — CSV nama kelurahan/kecamatan/kota yang dikenali
# classifier sebagai penanda lokasi. Kosong = daftar default historis.
# SERVICE_AREAS="rungkut,mulyosari,sidoarjo,surabaya"

# Alert webhook (opsional)
ALERT_WEBHOOK_URL=""

# Catatan: Blok AI Router Engine (V1) & Slot-Filling Engine (V2) telah DIHAPUS dari kode
# pada dekomisioning V2/V3. Variabel AI_ROUTER_*, SLOT_FILLING_*,
# FAST_FAQ_1CALL_ENABLED, AI_MODEL_ROUTER, ESCALATE_SCHEDULE_IN_INITIAL
# sudah tidak dibaca runtime. Arsitektur aktif: V3 Agent (2-Call Tool Routing).

# Humanizer / Human Typing Simulation Config
HUMANIZER_ENABLED=true                           # Toggle simulasi mengetik balasan manusia
HUMANIZER_READING_BASE_MS=400                    # Waktu reaksi awal membaca (ms)
HUMANIZER_READING_MS_PER_CHAR=15                 # Waktu membaca per karakter pesan masuk (ms)
HUMANIZER_READING_DELAY_MAX_MS=2500              # Batas maksimal jeda membaca pesan masuk (ms)
HUMANIZER_TYPING_AVERAGE_WPM=48                  # Kecepatan rata-rata mengetik HP (Rata-rata manusia: 25-55 WPM, max <=55 agar tidak seperti bot)
HUMANIZER_TYPING_REACTION_MS=300                 # Waktu reaksi saat mulai mengetik (ms)
HUMANIZER_MAX_TYPING_DELAY_MS=6500               # Batas maksimal durasi indikator mengetik per bubble (ms)
HUMANIZER_JITTER_PERCENT=20                      # Persentase variasi acak/jitter (+/- %) agar delay tidak kaku
HUMANIZER_BUBBLE_SPLIT_ENABLED=true              # Toggle pemotongan teks balasan panjang menjadi multiple bubble
HUMANIZER_BUBBLE_SINGLE_THRESHOLD_CHARS=350      # Batas panjang karakter di bawahnya dikirim dalam 1 bubble tunggal
HUMANIZER_BUBBLE_MAX_COUNT=2                     # Batas maksimal jumlah bubble per respons (maks 2 bubble)
HUMANIZER_BUBBLE_MAX_CHARS=250                   # Target batas karakter per bubble sebelum di-split (~250 char per bubble)
HUMANIZER_INTER_BUBBLE_DELAY_MIN_MS=900          # Jeda minimal antar pengiriman bubble (ms)
HUMANIZER_INTER_BUBBLE_DELAY_MAX_MS=1800         # Jeda maksimal antar pengiriman bubble (ms)
HUMANIZER_HTTP_TIMEOUT_MS=10000                  # Timeout guard panggilan API ke WAHA (ms)

# Temporary Safety Net: Terminal Approval before sending messages (true/false)
TERMINAL_APPROVAL_ENABLED=false

# Google Contacts Integration (OAuth 2.0 Credentials)
# Masukkan kredensial Anda di sini untuk mengaktifkan sinkronisasi otomatis ke Google Contacts
GOOGLE_CLIENT_ID=""                              # Google OAuth Client ID
GOOGLE_CLIENT_SECRET=""                          # Google OAuth Client Secret
GOOGLE_REFRESH_TOKEN=""                          # Google OAuth Refresh Token

# Google Calendar Integration (Service Account)
# Kosong = fallback Mock mode
GOOGLE_CALENDAR_CLIENT_EMAIL=""                  # Service Account email
GOOGLE_CALENDAR_PRIVATE_KEY=""                   # Service Account private key (ganti \n menjadi newline)
GOOGLE_CALENDAR_ID=""                            # ID kalender tujuan

# Ad Click Attribution & Meta Conversions API (CAPI)
TRACKING_API_KEY=""                              # Token pengaman untuk API Tracking, wajib diisi (fail-closed)
FB_PIXEL_ID=""                                   # ID Pixel Facebook Anda
FB_CAPI_ACCESS_TOKEN=""                          # Access Token dari Meta untuk Conversions API (Server-Side Events)

# Multi Landing Page — base URL publik tempat landing page disajikan
# (dipakai untuk preview URL di admin & resolusi /api/tenant/:slug). Kosong = fallback TRACKING_API_BASE_URL.
LANDING_BASE_URL="https://landing.example.com"
TRACKING_API_BASE_URL=""                          # Fallback base URL saat LANDING_BASE_URL kosong (preview /api/tenant/:slug)

# Follow-Up Milestone (Tahap 1: developmental milestone) — window deteksi kelahiran
MILESTONE_WINDOW_DAYS=15                          # Jendela deteksi milestone follow-up (hari; default 15)

# Landing page & tracking atribusi di-serve langsung oleh bot (port 3000 / domain utama).
# Nomor WA default jika parameter ?phone= tidak ada di query string.
DEFAULT_WHATSAPP_PHONE=628123456789

# === Daily Chat Export (Markdown untuk Analisa AI) ===
# Ekspor percakapan harian (USER + BOT + HUMAN_AGENT) ke file Markdown terstruktur
# agar mudah dianalisa AI. File disimpan di storage/exports (bisa diubah via CHAT_EXPORT_DIR)
# dan bisa di-download manual dari Admin Dashboard -> Daily Chat Export (AI).
# Data customer QA/sandbox (is_sandbox_test=true) otomatis DIKECUALIKAN dari ekspor.
ENABLE_CHAT_EXPORT_CRON=false                      # Aktifkan cron regenerasi file ekspor harian
CHAT_EXPORT_INTERVAL_HOURS=6                       # Interval cron (jam); file hari ini di-update tiap siklus
# CHAT_EXPORT_DIR="storage/exports"               # Direktori file ekspor (default storage/exports)



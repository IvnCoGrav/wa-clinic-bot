# .env.worker.example — contoh env KHUSUS container worker (F7 / G11a).
# JANGAN dipakai langsung: file `.env.worker` sebenarnya TIDAK ditulis manual,
# melainkan diturunkan dari `.env` oleh `node scripts/generate-worker-env.mjs`.
#
# Prinsip: worker tidak membuka HTTP, sehingga secret inbound webhook TIDAK boleh
# ada di sini (WAHA_WEBHOOK_SECRET, TELEGRAM_WEBHOOK_SECRET, WABA_APP_SECRET,
# WABA_WEBHOOK_VERIFY_TOKEN, WAHA_SWAGGER_PASSWORD, WAHA_DASHBOARD_PASSWORD).
# Daftar lengkap ada di scripts/env-contract.json.
#
# Key wajib (dicek `node scripts/check-env-contract.mjs`):
ADMIN_API_KEY=
WAHA_API_KEY=
BACKUP_ENCRYPTION_KEY=

# Key lain yang ikut disalin dari .env bila ada (contoh, bukan daftar lengkap):
# SUNGGUH JANGAN isi nilai asli di file example ini.
DATABASE_URL=
REDIS_HOST=
REDIS_PORT=6379
WAHA_BASE_URL=http://waha:3000
WAHA_SESSION=default
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=
WABA_TOKEN_ENCRYPTION_KEY=

{
  "name": "wa-clinic-bot",
  "version": "1.16.0",
  "description": "WhatsApp Automation Chatbot Engine for Clinic Treatment",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc && node scripts/copy-landing-assets.js",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "chat": "tsx src/cli/chat-simulator.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run tests/golden-corpus",
    "test:real-replay": "tsx scripts/replay-real-customer-cases.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "eval:numeric": "tsx tests/evals/numeric-hallucination-harness.ts",
    "seed:faq": "tsx src/cli/seed-faq.ts",
    "sync:knowledge": "tsx scripts/sync-live-knowledge.ts",
    "scrape:all": "tsx src/cli/scrape-all.ts",
    "sync:history": "tsx scripts/sync-waha-history.ts",
    "backfill:labels": "tsx scripts/backfill-customer-labels.ts"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/rate-limit": "^8.1.1",
    "@prisma/client": "^5.19.1",
    "axios": "^1.7.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.10",
    "capi-param-builder-nodejs": "^1.3.1",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "googleapis": "^173.0.0",
    "ioredis": "^5.11.1",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.14.9",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.19.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^2.0.1"
  }
}

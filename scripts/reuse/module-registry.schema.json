{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModuleRegistry",
  "description": "Skema JSON untuk registry modul kanonis wa-clinic-bot",
  "type": "object",
  "required": [
    "version",
    "capabilities"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "canonical",
          "exports",
          "forbiddenDeclarations",
          "allowedFiles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "canonical": {
            "type": "string",
            "minLength": 1
          },
          "exports": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "forbiddenDeclarations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

  "clinic_policies": [
    {
      "topic": "general_homecare_info",
      "factual_summary": "Kala Moms and Baby Spa melayani perawatan ibu dan bayi langsung di rumah Bunda (Homecare treatment). Seluruh peralatan, matras, aromaterapi, dan minyak khusus disiapkan oleh Bidan kami."
    },
    {
      "topic": "homebase_and_coverage",
      "factual_summary": "Homebase klinik kami berlokasi di Waru, Sidoarjo (dekat perbatasan Surabaya). Layanan resmi kami adalah Homecare (Bidan yang berkunjung langsung ke rumah Bunda) dengan area jangkauan seluruh Surabaya dan Sidoarjo (maksimal 30 km dari homebase)."
    },
    {
      "topic": "multi_child_transport",
      "factual_summary": "Biaya transport/ongkir dihitung per satu kali kedatangan (per alamat rumah). Jika Bunda memesan untuk 2 anak, 3 anak, atau Bunda + si kecil dalam 1 kunjungan, ongkir tetap dihitung 1 KALI SAJA."
    },
    {
      "topic": "operational_hours_and_booking",
      "factual_summary": "Layanan homecare buka setiap hari (Senin - Minggu) pukul 08.00 - 17.00 WIB. Pemilihan slot jam kunjungan dikoordinasikan oleh tim Bidan kami berdasarkan ketersediaan rute bidan yang bertugas."
    },
    {
      "topic": "payment_methods",
      "factual_summary": "Metode pembayaran tersedia via Transfer Bank (BCA, Mandiri, BRI), QRIS Universal, atau Cash langsung ke Bidan setelah treatment selesai. Nomor rekening resmi BCA a.n Kala Moms and Baby Spa akan diinfokan Admin saat konfirmasi jadwal."
    },
    {
      "topic": "post_vaccine_rules",
      "factual_summary": "Si kecil sebaiknya dipijat minimal 3 hari setelah imunisasi/vaksinasi, dengan syarat si kecil sudah dalam kondisi sehat dan tidak sedang demam/hangat."
    },
    {
      "topic": "therapist_qualification",
      "factual_summary": "Seluruh tenaga terapis di Kala Moms & Baby Spa adalah Bidan profesional lulusan D3/D4/Profesi Kebidanan yang memiliki STR (Surat Tanda Registrasi) aktif, terlatih khusus baby & mom treatment, dan menerapkan protokol higienis ketat."
    }
  ]

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum ConversationState {
  INITIAL
  AWAITING_LOCATION
  LOCATION_CONFIRMED
  AWAITING_INTEREST
  RESERVATION_SENT
  HUMAN_HANDLING
  COMPLETED
}

enum SourceType {
  FAQ
  DOCUMENT
}

enum WhatsappProvider {
  WAHA
  WABA
}

enum TreatmentCategory {
  BABY
  KIDS
  MOMS
  BOTH
}

enum AiCustomerScope {
  NEW_ONLY
  ALL
}

enum AiOverride {
  FORCE_ON
  FORCE_OFF
}

model Customer {
  id                      String         @id @default(uuid())
  tenant_id               String         @default("default-tenant")
  phone                   String         @unique
  name                    String?
  kelurahan               String?
  kecamatan               String?
  kota                    String?
  lat                     Float?
  lng                     Float?
  distance_km             Float?
  ongkir                  Int?
  is_out_of_coverage      Boolean        @default(false)
  pending_kelurahan       String?
  pending_kecamatan       String?
  pending_kota            String?
  pending_lat             Float?
  pending_lng             Float?
  zipcode                 String?
  pending_zipcode         String?
  status                  String         @default("active")
  block_reason            String?
  blocked_at              DateTime?
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt
  conversations           Conversation[]
  reservations            Reservation[]
  follow_ups              FollowUp[]
  children                Child[]
  adClick                 AdClick?
  pricelist_sent          Boolean        @default(false)
  share_location_sent     Boolean        @default(false)
  is_sandbox_test         Boolean        @default(false)
  marketing_opt_in        Boolean        @default(false)
  marketing_opt_in_at     DateTime?
  marketing_opt_in_source String?
  is_mql                  Boolean        @default(false)
  mql_triggered_at        DateTime?
  mql_bubble_count        Int            @default(0)
  is_legacy_source        Boolean        @default(false)
  legacy_scraped_at       DateTime?
  is_admin_labeled        Boolean        @default(false)
  is_hold_labeled         Boolean        @default(false)
  labels_synced_at        DateTime?
  ai_override             AiOverride?

  preferences             Json?
  labels                  CustomerLabel[]
  profile_picture_url        String?
  profile_picture_updated_at DateTime?

  google_resource_name       String?
  google_etag                String?
  google_synced_at           DateTime?

  ltv_cache               Int            @default(0)

  @@index([tenant_id])
  @@index([tenant_id, created_at])
  @@index([tenant_id, is_sandbox_test])
  @@index([tenant_id, is_mql])
  @@index([tenant_id, is_sandbox_test, created_at])
  @@index([ltv_cache])
  @@map("customers")
}

model Child {
  id                         String       @id @default(uuid())
  tenant_id                  String       @default("default-tenant")
  customer_id                String
  customer                   Customer     @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  reservation_id             String?
  reservation                Reservation? @relation(fields: [reservation_id], references: [id], onDelete: SetNull)
  name                       String
  birth_date                 DateTime?
  age_months_at_registration Int?
  raw_age_text               String?
  created_at                 DateTime     @default(now())
  updated_at                 DateTime     @updatedAt

  @@unique([customer_id, name])
  @@index([tenant_id])
  @@map("children")
}

model Conversation {
  id                          String             @id @default(uuid())
  tenant_id                   String             @default("default-tenant")
  customer_id                 String
  customer                    Customer           @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  current_state               ConversationState  @default(INITIAL)
  previous_state              ConversationState?
  location_attempts           Int                @default(0)
  is_human_handling           Boolean            @default(false)
  human_handling_since        DateTime?
  escalation_reason           String?
  consecutive_unknown_count   Int                @default(0)
  review_flagged              Boolean            @default(false)
  last_discussed_treatment    String?
  last_discussed_treatment_at DateTime?
  last_message_at             DateTime           @default(now())
  last_customer_message_at    DateTime?
  is_pinned                   Boolean            @default(false)
  pinned_at                   DateTime?
  is_manual_unread            Boolean            @default(false)
  created_at                  DateTime           @default(now())
  updated_at                  DateTime           @updatedAt
  messages                    Message[]

  @@index([tenant_id])
  @@index([tenant_id, is_pinned, last_message_at])
  @@index([tenant_id, is_human_handling, last_message_at])
  @@index([tenant_id, escalation_reason])
  @@index([tenant_id, review_flagged])
  @@map("conversations")
}

model AiRouterEvaluation {
  id        String @id @default(cuid())
  tenant_id String @default("default-tenant")

  customer_phone String
  message_text   String @db.Text
  current_state  String

  llm_raw_output    Json?
  llm_intent        String?
  llm_confidence    Float?
  llm_used_fallback Boolean @default(false)

  legacy_intent    String
  legacy_escalated Boolean

  intent_match     Boolean
  escalation_match Boolean
  mismatch_notes   String? @db.Text

  response_time_ms Int?

  created_at DateTime @default(now())

  @@index([tenant_id, created_at])
  @@index([intent_match])
  @@index([escalation_match])
  @@map("ai_router_evaluations")
}

model AiEvaluation {
  id              String   @id @default(cuid())
  tenant_id       String   @default("default-tenant")
  message_id      String   @unique
  customer_phone  String
  conversation_id String?
  message_text    String   @db.Text
  ai_reasoning    String?  @db.Text
  score           Int?
  feedback        String?  @db.Text
  created_at      DateTime @default(now())

  @@index([tenant_id, created_at])
  @@map("ai_evaluations")
}

model Message {
  id                    String       @id @default(uuid())
  tenant_id             String       @default("default-tenant")
  conversation_id       String
  conversation          Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  wa_message_id         String?      @unique
  direction             Direction
  content               String
  sender_type           String?      @default("BOT")
  sender_name           String?
  payload_raw           Json?
  delivery_status       String?
  is_revoked            Boolean      @default(false)
  revoked_at            DateTime?
  revoked_by            String?
  meta_error_code       String?
  meta_error_desc       String?
  meta_pricing_category String?
  delivered_at          DateTime?
  read_at               DateTime?
  created_at            DateTime     @default(now())

  @@index([tenant_id])
  @@index([conversation_id, tenant_id, created_at])
  @@map("messages")
}

model KnowledgeChunk {
  id            String     @id @default(uuid())
  tenant_id     String     @default("default-tenant")
  source_type   SourceType
  title         String
  content       String
  document_name String?
  created_at    DateTime   @default(now())

  @@index([tenant_id])
  @@map("knowledge_chunks")
}

model Reservation {
  id                       String            @id @default(uuid())
  tenant_id                String            @default("default-tenant")
  customer_id              String
  customer                 Customer          @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  treatment_category       TreatmentCategory
  treatment_detail         String?
  booking_date             DateTime?
  raw_text                 String?
  status                   String            @default("pending")
  google_calendar_event_id String?
  purchase_event_sent_at   DateTime?
  purchase_occurred_at     DateTime?
  purchase_value           Int?
  purchase_review_status   String            @default("pending")
  payment_method           String?
  proof_url                String?
  is_repeat_order          Boolean           @default(false)
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt
  children                 Child[]
  assigned_staff_id        String?
  assigned_staff           Staff?            @relation(fields: [assigned_staff_id], references: [id], onDelete: SetNull)
  follow_ups               FollowUp[]

  @@index([tenant_id])
  @@index([tenant_id, created_at])
  @@index([customer_id])
  @@index([customer_id, status])
  @@index([assigned_staff_id])
  @@map("reservations")
}

enum FollowUpType {
  NO_PURCHASE
  NEXT_TREATMENT
  REMINDER_H1
  REVIEW_H1_BABY
  REVIEW_H1_MOMS
}

enum FollowUpStatus {
  PENDING
  QUEUED
  SENT
  CANCELLED
  FAILED
  SKIPPED
}

model WabaTemplate {
  id            String   @id @default(uuid())
  tenant_id     String   @default("default-tenant")
  type          String // FollowUpTemplateType: NO_PURCHASE_1, NEXT_TREATMENT_1, dst
  variant       Int // 1, 2, 3 (mapping ke follow-up stage)
  template_name String // Nama HSM template di Meta (ter-approve)
  category      String // UTILITY | MARKETING
  language_code String   @default("id")
  status        String   @default("APPROVED") // APPROVED | PENDING | REJECTED | PAUSED
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([tenant_id, type, variant])
  @@index([tenant_id, type])
  @@map("waba_templates")
}

model DeliveryTier {
  id             String   @id @default(uuid())
  tenant_id      String
  max_dist       Float // Jarak maksimum dalam km
  fee            Int // Ongkir normal (Rp)
  promo_discount Int // Potongan diskon promo (Rp)
  sort_order     Int // Urutan tier (1 = terdekat)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([tenant_id, sort_order])
  @@map("delivery_tiers")
}

model ClinicService {
  id               String   @id @default(uuid())
  tenant_id        String
  service_id       String // ID layanan (misal "baby-massage-ceria")
  name             String
  category         String // BABY | KIDS | MOMS | BOTH
  min_age_months   Int
  max_age_months   Int? // null = tanpa batas
  age_label        String
  duration_minutes Int
  original_price   Int
  promo_price      Int
  description      String
  is_active        Boolean  @default(true)
  sort_order       Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([tenant_id, service_id])
  @@index([tenant_id])
  @@map("clinic_services")
}

model TenantPersona {
  id                  String   @id @default(uuid())
  tenant_id           String   @unique
  persona             String // Teks persona Bidan Yusi (system prompt)
  max_chars_per_reply Int? // Batas maksimal karakter untuk 1 balasan AI (null = tanpa limit)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("tenant_persona")
}

model FewShotExemplar {
  id               String   @id @default(uuid())
  tenant_id        String   @default("default-tenant")
  scenario         String   // Deskripsi skenario
  customer_message String   // Pesan masuk pasien
  ideal_response   String   // Balasan ideal Bidan Yusi
  tags             String[] @default([]) // Tag intent untuk matching
  is_active        Boolean  @default(true)
  sort_order       Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([tenant_id])
  @@map("few_shot_exemplars")
}

model TenantAiConfig {
  id                   String   @id @default(uuid())
  tenant_id            String
  task                 String // HARVESTING | CHAT_REPLY | MEDICAL_CHECK | SUMMARIZATION | PII_SCRUBBING | INTENT_CLASSIFICATION
  provider             String
  model_name           String
  max_tokens           Int
  temperature          Float
  confidence_threshold Float?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@unique([tenant_id, task])
  @@map("tenant_ai_config")
}

model TenantGoogleIntegration {
  id                   String    @id @default(uuid())
  tenant_id            String    @unique @default("default-tenant")
  is_enabled           Boolean   @default(false)
  connected_email      String?
  refresh_token        String?
  access_token         String?
  token_expiry         DateTime?
  auto_sync_on_chat    Boolean   @default(true)
  auto_sync_on_reserve Boolean   @default(true)
  naming_template      String    @default("{{name}} - {{child_name}}")
  contact_label        String?   @default("Pasien Klinik")
  last_synced_at       DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@index([tenant_id])
  @@map("tenant_google_integrations")
}

model FollowUpTemplate {
  id         String   @id @default(uuid())
  tenant_id  String   @default("default-tenant")
  type       String // REMINDER_H0, REVIEW_H1_BABY, NO_PURCHASE_1, dst
  variant    Int // 1, 2, 3
  text       String // Template teks dengan placeholder {name} {time} {babyName}
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, type, variant])
  @@index([tenant_id, type])
  @@map("follow_up_templates")
}

model FollowUp {
  id             String         @id @default(uuid())
  tenant_id      String         @default("default-tenant")
  customer_id    String
  customer       Customer       @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  reservation_id String?
  reservation    Reservation?   @relation(fields: [reservation_id], references: [id], onDelete: SetNull)
  type           FollowUpType
  stage          Int // 1 | 2 | 3
  custom_text    String?
  scheduled_at   DateTime
  sent_at        DateTime?
  status         FollowUpStatus @default(QUEUED)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  @@index([tenant_id])
  @@index([reservation_id])
  @@index([status, scheduled_at])
  @@map("follow_ups")
}

model AuditLog {
  id             String   @id @default(uuid())
  tenant_id      String   @default("default-tenant")
  admin_key      String
  admin_identity String?
  action         String
  target_id      String?
  payload        String?
  ip_address     String?
  created_at     DateTime @default(now())

  @@index([tenant_id])
  @@map("audit_logs")
}

model AdClick {
  id           String  @id @default(cuid())
  trackingCode String? @unique

  fbclid      String?
  fbp         String?
  fbc         String?
  ipAddress   String?
  userAgent   String?
  landingUrl  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  ctwa_clid   String?
  phone       String?
  matchedAt   DateTime?
  customerId  String?   @unique
  customer    Customer? @relation(fields: [customerId], references: [id])
  createdAt   DateTime  @default(now())
  tenant_id   String

  @@index([tenant_id])
  @@index([trackingCode])
  @@map("ad_clicks")
}

model LandingPageView {
  id          String   @id @default(cuid())
  tenant_id   String   @default("default-tenant")
  landingUrl  String?
  fbclid      String?
  fbp         String?
  fbc         String?
  ipAddress   String?
  userAgent   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  utmId       String?
  createdAt   DateTime @default(now())

  @@index([tenant_id])
  @@index([tenant_id, createdAt])
  @@map("landing_page_views")
}

enum StagingStatus {
  PENDING
  APPROVED
  REJECTED
  COMMITTED
}

model LegacyStaging {
  id                       String        @id @default(uuid())
  tenantId                 String        @default("default")
  phoneNumber              String        @unique
  name                     String?
  extractedLocation        String?
  leadCreatedAt            DateTime
  firstPurchaseAt          DateTime?
  extractedReservationJson Json?
  status                   StagingStatus @default(PENDING)
  rawMessagesCount         Int           @default(0)
  rawMessagesJson          Json
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("legacy_staging")
}

enum LandingType {
  STRUCTURED_JSON
  RAW_HTML
}

model LandingPage {
  id                 String      @id @default(uuid())
  tenant_id          String      @default("default-tenant")
  slug               String      @unique
  title              String
  landing_type       LandingType @default(RAW_HTML)
  html_content       String?     @db.Text
  structured_content Json?
  meta_pixel_id      String?
  whatsapp_number    String?
  events             String[]    @default([])
  is_active          Boolean     @default(true)
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  @@index([tenant_id])
  @@map("landing_pages")
}

model Tenant {
  id                        String           @id @default(uuid())
  slug                      String           @unique
  name                      String
  whatsapp_number           String?
  meta_pixel_id             String?
  meta_capi_access_token    String?
  landing_type              LandingType      @default(STRUCTURED_JSON)
  landing_content           Json?
  raw_html_content          String?
  whatsapp_provider         WhatsappProvider @default(WAHA)
  waha_session_id           String?          @default("default")
  waha_outbound_cutoff      Boolean          @default(false)
  waba_phone_number_id      String?
  waba_business_account_id  String?
  waba_access_token         String?
  waba_webhook_verify_token String?
  waba_app_secret           String?
  ai_router_enabled         Boolean          @default(true)
  ai_router_shadow_mode     Boolean          @default(true)
  ai_verifier_enabled       Boolean          @default(true)
  ai_customer_scope         AiCustomerScope  @default(NEW_ONLY)
  ai_scope_cutoff_at        DateTime         @default(now())
  manual_reply_escalates    Boolean          @default(true)
  idle_greeting_enabled     Boolean          @default(true)
  idle_greeting_min_hours   Int              @default(36)
  mql_threshold_bubbles     Int              @default(5)
  mql_auto_lead_enabled     Boolean          @default(true)
  media_retention_days      Int              @default(30)
  media_quota_bytes         Int              @default(209715200)
  message_retention_days    Int              @default(120)
  daily_report_enabled      Boolean          @default(false)
  daily_report_hour         Int              @default(7)
  telegram_bot_token            String?
  telegram_chat_id              String?
  telegram_pairing_token        String?          @unique
  telegram_topic_daily_report   String?
  telegram_topic_system_errors  String?
  telegram_topic_medical_alerts String?
  pricelist_image_url           String?
  cs_name                   String?          @default("Cs Yusi")
  format_visit              String?          @default("Promo[%ID%]")
  greetings_text            String?          @default("Promo [%ID%]")
  format_checkout           String?          @default("list untuk reservasi :")
  format_purchase           String?          @default("Payment")
  format_value              String?          @default("Treatment = %VALUE%")
  landing_domain            String?          @default("")
  auto_send_purchase_capi   Boolean          @default(false)
  created_at                DateTime         @default(now())
  updated_at                DateTime         @updatedAt

  @@index([slug])
  @@map("tenants")
}

enum StagingReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
  EXISTING_MATCH
}

model MedicalFaqStaging {
  id                 String              @id @default(uuid())
  tenant_id          String              @default("default-tenant")
  conversation_id    String?
  customer_phone     String
  raw_question       String
  bidan_raw_reply    String?
  general_question   String?
  general_answer     String?
  symptoms_tagged    String[]
  status             StagingReviewStatus @default(PENDING)
  matched_chunk_id   String?
  matched_similarity Float?
  reviewed_by        String?
  reviewed_at        DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  @@index([tenant_id])
  @@index([status])
  @@map("medical_faq_staging")
}

model GeneralFaqStaging {
  id                 String              @id @default(uuid())
  tenant_id          String              @default("default-tenant")
  conversation_id    String?
  raw_question       String
  raw_answer         String?
  general_question   String?
  general_answer     String?
  category           String              @default("general")
  status             StagingReviewStatus @default(PENDING)
  matched_chunk_id   String?
  matched_similarity Float?
  reviewed_by        String?
  reviewed_at        DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  @@index([tenant_id])
  @@index([status])
  @@map("general_faq_staging")
}

model DailyReportLog {
  id          String   @id @default(uuid())
  tenant_id   String   @default("default-tenant")
  report_date String // format "YYYY-MM-DD" (WIB)
  sent_at     DateTime @default(now())
  status      String   @default("sent") // "sent" | "failed"
  metadata    Json? // opsional: simpan snapshot angka yang dikirim

  @@unique([tenant_id, report_date])
  @@index([tenant_id])
  @@map("daily_report_logs")
}

model LlmAuditLog {
  id                String   @id @default(uuid())
  tenant_id         String   @default("default-tenant")
  customer_phone    String
  conversation_id   String?
  provider          String?
  model_name        String
  task_type         String // NLU_ROUTING, CHAT_REPLY, dst
  prompt_tokens     Int
  completion_tokens Int
  cached_prompt_tokens Int    @default(0)
  cost_idr          Float
  error_code        String?
  latency_ms        Int?
  eval_run          String?
  created_at        DateTime @default(now())

  @@index([tenant_id, created_at])
  @@index([customer_phone])
  @@map("llm_audit_logs")
}

enum StaffRole {
  SUPER_ADMIN
  TENANT_ADMIN
  ADMIN_CS
  ADVERTISER
  THERAPIST
}

model Staff {
  id            String         @id @default(uuid())
  tenant_id     String         @default("default-tenant")
  name          String
  phone         String         @unique
  password_hash String
  role                   String         @default("THERAPIST")
  active                 Boolean        @default(true)
  telegram_chat_id       String?
  telegram_pairing_token String?        @unique
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt
  reservations  Reservation[]
  sessions      StaffSession[]

  @@index([tenant_id])
  @@map("staff")
}

model StaffSession {
  id         String    @id @default(uuid())
  staff_id   String
  staff      Staff     @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  created_at DateTime  @default(now())
  expires_at DateTime
  revoked_at DateTime?

  @@index([staff_id])
  @@index([token_hash])
  @@map("staff_sessions")
}

model Label {
  id          String          @id @default(uuid())
  tenant_id   String          @default("default-tenant")
  name        String
  color       String          @default("#008069")
  description String?
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  customers   CustomerLabel[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("labels")
}

model CustomerLabel {
  customer_id String
  label_id    String
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  label       Label    @relation(fields: [label_id], references: [id], onDelete: Cascade)
  assigned_at DateTime @default(now())

  @@id([customer_id, label_id])
  @@index([customer_id])
  @@index([label_id])
  @@map("customer_labels")
}

model PushSubscription {
  id         String   @id @default(uuid())
  tenant_id  String   @default("default-tenant")
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_type  String   @default("ADMIN") // ADMIN | STAFF
  user_id    String?
  user_agent String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id, user_type])
  @@map("push_subscriptions")
}

model CustomRole {
  id               String   @id @default(uuid())
  tenant_id        String   @default("default-tenant")
  key              String
  label            String
  description      String?
  allowed_paths    String[] @default([])
  default_redirect String   @default("/admin/overview")
  is_system        Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([tenant_id, key])
  @@index([tenant_id])
  @@map("custom_roles")
}





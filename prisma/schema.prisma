datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum ConversationState {
  INITIAL
  AWAITING_LOCATION
  LOCATION_CONFIRMED
  AWAITING_INTEREST
  RESERVATION_SENT
  HUMAN_HANDLING
  COMPLETED
}

enum SourceType {
  FAQ
  DOCUMENT
}

enum TreatmentCategory {
  BABY
  MOMS
  BOTH
}

model Customer {
  id                 String         @id @default(uuid())
  tenant_id          String         @default("default-tenant")
  phone              String         @unique
  name               String?
  kelurahan          String?
  kecamatan          String?
  kota               String?
  lat                Float?
  lng                Float?
  distance_km        Float?
  ongkir             Int?
  is_out_of_coverage Boolean        @default(false)
  pending_kelurahan  String?
  pending_kecamatan  String?
  pending_kota       String?
  pending_lat        Float?
  pending_lng        Float?
  zipcode            String?
  pending_zipcode    String?
  status             String         @default("active")
  block_reason       String?
  blocked_at         DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  conversations      Conversation[]
  reservations       Reservation[]

  @@index([tenant_id])
  @@map("customers")
}

model Conversation {
  id                   String            @id @default(uuid())
  tenant_id            String            @default("default-tenant")
  customer_id          String
  customer             Customer          @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  current_state        ConversationState @default(INITIAL)
  previous_state       ConversationState?
  location_attempts    Int               @default(0)
  is_human_handling    Boolean           @default(false)
  human_handling_since DateTime?
  review_flagged       Boolean           @default(false)
  last_message_at      DateTime          @default(now())
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  messages             Message[]

  @@index([tenant_id])
  @@map("conversations")
}

model Message {
  id              String       @id @default(uuid())
  tenant_id       String       @default("default-tenant")
  conversation_id String
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  wa_message_id   String?      @unique
  direction       Direction
  content         String
  payload_raw     Json?
  created_at      DateTime     @default(now())

  @@index([tenant_id])
  @@map("messages")
}

model KnowledgeChunk {
  id            String     @id @default(uuid())
  tenant_id     String     @default("default-tenant")
  source_type   SourceType
  title         String
  content       String
  document_name String?
  created_at    DateTime   @default(now())

  @@index([tenant_id])
  @@map("knowledge_chunks")
}

model Reservation {
  id                 String            @id @default(uuid())
  tenant_id          String            @default("default-tenant")
  customer_id        String
  customer           Customer          @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  treatment_category TreatmentCategory
  treatment_detail   String?
  booking_date       DateTime?
  raw_text           String?
  status             String            @default("pending")
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  @@index([tenant_id])
  @@map("reservations")
}

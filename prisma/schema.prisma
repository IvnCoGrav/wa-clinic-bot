datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum ConversationState {
  INITIAL
  AWAITING_LOCATION
  LOCATION_CONFIRMED
  AWAITING_INTEREST
  RESERVATION_SENT
  HUMAN_HANDLING
  COMPLETED
}

enum SourceType {
  FAQ
  DOCUMENT
}

enum TreatmentCategory {
  BABY
  MOMS
  BOTH
}

model Customer {
  id                 String         @id @default(uuid())
  tenant_id          String         @default("default-tenant")
  phone              String         @unique
  name               String?
  kelurahan          String?
  kecamatan          String?
  kota               String?
  lat                Float?
  lng                Float?
  distance_km        Float?
  ongkir             Int?
  is_out_of_coverage Boolean        @default(false)
  pending_kelurahan  String?
  pending_kecamatan  String?
  pending_kota       String?
  pending_lat        Float?
  pending_lng        Float?
  zipcode            String?
  pending_zipcode    String?
  status             String         @default("active")
  block_reason       String?
  blocked_at         DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  conversations      Conversation[]
  reservations       Reservation[]
  follow_ups         FollowUp[]
  adClick            AdClick?
  pricelist_sent     Boolean        @default(false)
  is_sandbox_test    Boolean        @default(false)

  @@index([tenant_id])
  @@map("customers")
}

model Conversation {
  id                   String            @id @default(uuid())
  tenant_id            String            @default("default-tenant")
  customer_id          String
  customer             Customer          @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  current_state        ConversationState @default(INITIAL)
  previous_state       ConversationState?
  location_attempts    Int               @default(0)
  is_human_handling    Boolean           @default(false)
  human_handling_since DateTime?
  escalation_reason    String?
  review_flagged       Boolean           @default(false)
  last_message_at      DateTime          @default(now())
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  messages             Message[]

  @@index([tenant_id])
  @@map("conversations")
}

model Message {
  id              String       @id @default(uuid())
  tenant_id       String       @default("default-tenant")
  conversation_id String
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  wa_message_id   String?      @unique
  direction       Direction
  content         String
  payload_raw     Json?
  created_at      DateTime     @default(now())

  @@index([tenant_id])
  @@map("messages")
}

model KnowledgeChunk {
  id            String     @id @default(uuid())
  tenant_id     String     @default("default-tenant")
  source_type   SourceType
  title         String
  content       String
  document_name String?
  created_at    DateTime   @default(now())

  @@index([tenant_id])
  @@map("knowledge_chunks")
}

model Reservation {
  id                 String            @id @default(uuid())
  tenant_id          String            @default("default-tenant")
  customer_id        String
  customer           Customer          @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  treatment_category TreatmentCategory
  treatment_detail   String?
  booking_date       DateTime?
  raw_text                 String?
  status                   String            @default("pending")
  google_calendar_event_id String?
  is_repeat_order          Boolean           @default(false)
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt

  @@index([tenant_id])
  @@map("reservations")
}

enum FollowUpType {
  NO_PURCHASE
  NEXT_TREATMENT
}

enum FollowUpStatus {
  PENDING
  QUEUED
  SENT
  CANCELLED
}

model FollowUp {
  id           String         @id @default(uuid())
  tenant_id    String         @default("default-tenant")
  customer_id  String
  customer     Customer       @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  type         FollowUpType
  stage        Int            // 1 | 2 | 3
  scheduled_at DateTime
  sent_at      DateTime?
  status       FollowUpStatus @default(PENDING)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  @@index([tenant_id])
  @@index([status, scheduled_at])
  @@map("follow_ups")
}

model AuditLog {
  id             String   @id @default(uuid())
  tenant_id      String   @default("default-tenant")
  admin_key      String
  admin_identity String?
  action         String
  target_id      String?
  payload        String?
  ip_address     String?
  created_at     DateTime @default(now())

  @@index([tenant_id])
  @@map("audit_logs")
}

model AdClick {
  id           String    @id @default(cuid())
  trackingCode String?   @unique

  fbclid       String?
  fbp          String?
  fbc          String?
  ipAddress    String?
  userAgent    String?
  landingUrl   String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  phone        String?
  matchedAt    DateTime?
  customerId   String?   @unique
  customer     Customer? @relation(fields: [customerId], references: [id])
  createdAt    DateTime  @default(now())
  tenant_id    String

  @@index([tenant_id])
  @@index([trackingCode])
  @@map("ad_clicks")
}

enum StagingStatus {
  PENDING
  APPROVED
  REJECTED
  COMMITTED
}

model LegacyStaging {
  id                       String        @id @default(uuid())
  tenantId                 String        @default("default")
  phoneNumber              String        @unique
  name                     String?
  extractedLocation        String?
  leadCreatedAt            DateTime
  firstPurchaseAt          DateTime?
  extractedReservationJson Json?
  status                   StagingStatus @default(PENDING)
  rawMessagesCount         Int           @default(0)
  rawMessagesJson          Json
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("legacy_staging")
}

enum LandingType {
  STRUCTURED_JSON
  RAW_HTML
}

model Tenant {
  id                     String      @id @default(uuid())
  slug                   String      @unique
  name                   String
  whatsapp_number        String      @default("6287751148065")
  meta_pixel_id          String?
  meta_capi_access_token String?
  landing_type           LandingType @default(STRUCTURED_JSON)
  landing_content        Json?
  raw_html_content       String?
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt

  @@index([slug])
  @@map("tenants")
}

enum StagingReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
  EXISTING_MATCH
}

model MedicalFaqStaging {
  id               String              @id @default(uuid())
  tenant_id        String              @default("default-tenant")
  conversation_id  String?
  customer_phone   String
  raw_question     String
  bidan_raw_reply  String?
  general_question String?
  general_answer   String?
  symptoms_tagged  String[]
  status           StagingReviewStatus @default(PENDING)
  matched_chunk_id String?
  matched_similarity Float?
  reviewed_by      String?
  reviewed_at      DateTime?
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  @@index([tenant_id])
  @@index([status])
  @@map("medical_faq_staging")
}

model GeneralFaqStaging {
  id               String              @id @default(uuid())
  tenant_id        String              @default("default-tenant")
  conversation_id  String?
  raw_question     String
  raw_answer       String?
  general_question String?
  general_answer   String?
  category         String              @default("general")
  status           StagingReviewStatus @default(PENDING)
  matched_chunk_id String?
  matched_similarity Float?
  reviewed_by      String?
  reviewed_at      DateTime?
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  @@index([tenant_id])
  @@index([status])
  @@map("general_faq_staging")
}





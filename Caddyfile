{
    servers {
        protocols h1 h2
    }
}

{$APP_DOMAIN:app.kalababyspa.online} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https: blob:; font-src 'self' data: https:; connect-src 'self' https: wss: ws:; frame-ancestors 'self';"
        Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
        -Server
    }

    # AI Copilot: stream SSE panjang (budget 5 menit). lb_try_duration 0s penting
    # agar proxy tidak me-retry POST yang sudah berjalan (mencegah biaya LLM ganda).
    @copilot path /api/admin/copilot/stream
    handle @copilot {
        reverse_proxy app:3000 {
            lb_try_duration 0s
            flush_interval -1
            transport http {
                keepalive 300s
                keepalive_idle_conns 100
                response_header_timeout 360s
            }
        }
    }

    # Route khusus Server-Sent Events (SSE)
    @sse path /api/admin/live-chat/events
    handle @sse {
        reverse_proxy app:3000 {
            # Retry jeda dial saat container app di-recreate (insiden 502 /cta 26-09-2026, #135).
            # Hanya menutup kegagalan koneksi awal; stream yang sudah jalan tidak di-retry.
            lb_try_duration 30s
            lb_try_interval 2s
            flush_interval -1
            transport http {
                keepalive 300s
                keepalive_idle_conns 100
                response_header_timeout 300s
            }
        }
    }

    handle {
        reverse_proxy app:3000 {
            # Retry jeda dial saat container app di-recreate (insiden 502 /cta 26-09-2026, #135).
            lb_try_duration 30s
            lb_try_interval 2s
            transport http {
                keepalive 60s
                keepalive_idle_conns 100
            }
        }
    }
}

{$HERMES_DOMAIN:hermes.kalababyspa.online} {
    encode gzip zstd

    handle /kala* {
        reverse_proxy hermes-agent:8621
    }

    handle {
        reverse_proxy hermes-agent:9119
    }
}

{$ROUTER_DOMAIN:router.kalababyspa.online} {
    encode gzip zstd
    reverse_proxy hermes-9router:20128
}

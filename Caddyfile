{
    servers {
        protocols h1 h2
    }
}

app.kalababyspa.online {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }

    # Route khusus Server-Sent Events (SSE)
    @sse path /api/admin/live-chat/events
    handle @sse {
        reverse_proxy app:3000 {
            # Retry jeda dial saat container app di-recreate (insiden 502 /cta 26-09-2026, #135).
            # Hanya menutup kegagalan koneksi awal; stream yang sudah jalan tidak di-retry.
            lb_try_duration 30s
            lb_try_interval 2s
            flush_interval -1
            transport http {
                keepalive 300s
                keepalive_idle_conns 100
                response_header_timeout 300s
            }
        }
    }

    handle {
        reverse_proxy app:3000 {
            # Retry jeda dial saat container app di-recreate (insiden 502 /cta 26-09-2026, #135).
            lb_try_duration 30s
            lb_try_interval 2s
            transport http {
                keepalive 60s
                keepalive_idle_conns 100
            }
        }
    }
}
